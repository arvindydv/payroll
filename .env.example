POSTGRES_USER=payroll
POSTGRES_PASSWORD=change_me
POSTGRES_DB=payroll
DATABASE_URL=postgresql://payroll:change_me@postgres:5432/payroll
# Used only for `prisma migrate`. Locally this is the same as DATABASE_URL.
# On Neon, DATABASE_URL is the pooled connection string and DIRECT_URL is the
# unpooled one (required for migrations) — see README "Deploying for free".
DIRECT_URL=postgresql://payroll:change_me@postgres:5432/payroll

JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

ADMIN_EMAIL=admin@yugenterprises.com
ADMIN_PASSWORD=change_me

# Comma-separated list of allowed frontend origins in production.
# Leave unset for local dev (allows all origins).
CORS_ORIGIN=

VITE_API_URL=http://localhost:4000/api
